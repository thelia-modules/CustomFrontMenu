{#
  Module configuration screen: the list of menus. Composing one happens on its own page,
  so the menu being edited is in the URL rather than in a cookie.
#}
{% set domain = 'customfrontmenu.bo.default-twig' %}

<div class="row g-3" data-testid="custom-front-menu-list">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">{{ 'Menus'|trans({}, domain) }}</div>

            {% if menus is empty %}
                <div class="card-body text-muted">
                    {{ 'No menu yet. Create one to get started.'|trans({}, domain) }}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Name'|trans({}, domain) }}</th>
                                <th scope="col" class="text-end">{{ 'Entries'|trans({}, domain) }}</th>
                                <th scope="col" class="text-end">{{ 'Front-office call'|trans({}, domain) }}</th>
                                <th scope="col" class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for menu in menus %}
                                <tr data-testid="custom-front-menu-row-{{ menu.id }}">
                                    <td>
                                        <a href="{{ url('admin.customfrontmenu.menus.show', { menuId: menu.id }) }}" class="text-decoration-none fw-medium">
                                            {{ menu.title }}
                                        </a>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-light text-muted border">{{ menu.entryCount }}</span>
                                    </td>
                                    <td class="text-end">
                                        <code class="small">{{ '{{ custom_front_menu(' ~ menu.id ~ ') }}' }}</code>
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ url('admin.customfrontmenu.menus.show', { menuId: menu.id }) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-diagram-3" aria-hidden="true"></i> {{ 'Compose'|trans({}, domain) }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">{{ 'Add a new menu'|trans({}, domain) }}</div>
            <div class="card-body">
                <form method="POST" action="{{ url('admin.customfrontmenu.menus.create') }}">
                    <div class="mb-3">
                        <label class="form-label" for="cfm-menu-title">{{ 'Menu name'|trans({}, domain) }}</label>
                        <input type="text" class="form-control" id="cfm-menu-title" name="title" required>
                    </div>
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Create'|trans({}, domain) }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
